<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Holds the SQL Server migration set. See the PostgreSQL project for why the two are
    separate assemblies rather than one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AuthService.Migrations.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuthService.Data\AuthService.Data.csproj" />
  </ItemGroup>

</Project>
