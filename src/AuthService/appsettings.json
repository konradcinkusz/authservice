{
  "DatabaseProvider": "PostgreSQL",
  "Database": {
    "SchemaMode": "EnsureCreated",
    "MigrationsAssembly": ""
  },
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "AuthService",
    "ExpirationMinutes": "60",
    "RefreshTokenDays": "7"
  },
  "Auth": {
    "RevokeSessionsOnPasswordChange": true,
    "ReissueTokensOnPasswordChange": true,
    "RequireVerifiedProviderEmail": true,
    "AllowTokensInOAuthRedirect": false
  },
  "Network": {
    "ClientIpHeader": "",
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1,
    "TrustAllProxies": false
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "CallbackBaseUrl": "",
    "PostLoginRedirectBaseUrl": "",
    "PostLoginRedirectAllowedBaseUrls": [],
    "ErrorRedirectBaseUrl": ""
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": ""
  },
  "App": {
    "Name": "Auth Service"
  },
  "FrontendBaseUrl": "",
  "ConsentVersions": {
    "Terms": "2026-01-01",
    "Privacy": "2026-01-01",
    "Cookies": "2026-01-01"
  },
  "InitialAdmin": {
    "Email": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
