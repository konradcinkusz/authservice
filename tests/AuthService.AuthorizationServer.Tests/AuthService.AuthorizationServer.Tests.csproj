<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The authorization server's tests, in a project of their own because they need a host
    configured differently from AuthService.Tests: RS256 rather than HS256, with MCP clients
    configured. That project configures its host through process-wide environment variables,
    so a second key configuration in the same process would race it; a separate test project
    runs in its own process (AUTH-MCP-01, N14).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Kept in step with Microsoft.AspNetCore.Mvc.Testing, as in AuthService.Tests. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AuthService\AuthService.csproj" />
  </ItemGroup>

</Project>
